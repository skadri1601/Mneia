{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push origin:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm changeset:*)",
      "Bash(npx tsx:*)",
      "Bash(node:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git push origin main:*)",
      "Bash(gh pr merge:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/git-lane-guard.mjs",
            "timeout": 15,
            "statusMessage": "Checking git lane policy"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/worktree-guard.mjs",
            "timeout": 15,
            "statusMessage": "Checking worktree policy"
          }
        ]
      }
    ]
  }
}
