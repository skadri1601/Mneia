# The inventory of what apps/web reads in production. Names and purposes here, VALUES NEVER.
#
# On the droplet this lives at /etc/mneia/web.env, which deploy/docker-compose.yml loads
# via env_file. That file is not in the repository and must never be — this one exists so
# the set of variables, and what breaks without each, is reviewable in a diff.
#
# After changing anything here, restart the service: the app reads process.env at runtime.

# ---------------------------------------------------------------------------
# Required — the app cannot serve without these
# ---------------------------------------------------------------------------

# Direct Neon connection string. The role must NOT hold SUPERUSER or BYPASSRLS:
# every store in apps/web calls assertConnectionEnforcesRls per transaction and will
# refuse the connection. Provision one with `node scripts/db-provision-app-role.mjs --apply`.
# Check the live posture with: curl -s https://app.mneia.dev/api/health
DATABASE_URL=

# Clerk. The publishable key is also needed at BUILD time — deploy-web.yml passes it as a
# Docker build-arg, so changing it means rebuilding, not just restarting.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Required to admit anyone from the waitlist (MNE-233)
# ---------------------------------------------------------------------------

# Comma-separated Clerk user ids allowed to open /admin. If this is unset, /admin denies
# EVERYONE — including the founder — and the waitlist queue is unreachable even though the
# code is fine. This is the single most common reason admission appears broken.
MNEIA_SUPER_ADMIN_SUBJECTS=

# Resend credentials for the access email. If either is unset, approving a signup is
# REFUSED rather than approving someone we then cannot reach.
RESEND_API_KEY=
WAITLIST_FROM=

# ---------------------------------------------------------------------------
# Optional — sensible defaults, set them only to override
# ---------------------------------------------------------------------------

# Origin of the app itself, used to build device-flow verification URLs.
# Defaults to https://app.mneia.dev
# MNEIA_APP_ORIGIN=

# Origin of the marketing site, used for links inside the access email.
# MNEIA_SITE_ORIGIN=

# Absolute path for the §17 telemetry JSONL sink. Unset means telemetry is a no-op,
# which loses the arbitration dataset — the thing docs/BUSINESS.md calls the moat.
# MNEIA_TELEMETRY_PATH=

# Opt-out switch and remote sink for the §17 event spine.
# MNEIA_TELEMETRY=
# MNEIA_TELEMETRY_ENDPOINT=
# MNEIA_TELEMETRY_TOKEN=

# ---------------------------------------------------------------------------
# Must NOT be set in production
# ---------------------------------------------------------------------------

# Setting this to 1 disables the row-level-security guard on every connection, which
# makes every workspace-isolation policy inert (§11.3). /api/health reports
# rls=bypassed_by_escape_hatch when it is set, so the state is visible rather than silent.
# MNEIA_ALLOW_RLS_BYPASS=
