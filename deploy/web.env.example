# The inventory of what apps/web reads in production. Names and purposes here, VALUES NEVER.
#
# On the droplet this lives at /etc/mneia/web.env, which deploy/docker-compose.yml loads
# via env_file. That file is not in the repository and must never be — this one exists so
# the set of variables, and what breaks without each, is reviewable in a diff.
#
# After changing anything here, restart the service: the app reads process.env at runtime.

# ---------------------------------------------------------------------------
# Required — the app cannot serve without these
# ---------------------------------------------------------------------------

# Direct Neon connection string. The role must NOT hold SUPERUSER or BYPASSRLS:
# every store in apps/web calls assertConnectionEnforcesRls per transaction and will
# refuse the connection. Provision one with `node scripts/db-provision-app-role.mjs --apply`.
# Check the live posture with: curl -s https://app.mneia.dev/api/health
DATABASE_URL=

# Clerk. The publishable key is also needed at BUILD time — deploy-web.yml passes it as a
# Docker build-arg, so changing it means rebuilding, not just restarting.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OpenAI. Serves two calls: extraction on checkpoint (gpt-5.6-luna) and the
# embeddings that make semantic ranking work at all (text-embedding-3-small).
# Without it, checkpoint cannot propose anything and semanticRelevance — 30% of
# the rehydration score — stays a neutral constant.
OPENAI_API_KEY=

# Anthropic. The extraction fallback only. It is used when OpenAI returns 5xx,
# 429, or times out, which is why the published subprocessor table still names
# Anthropic. Without it a single-vendor outage takes checkpoint down entirely.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Required to admit anyone from the waitlist (MNE-233)
# ---------------------------------------------------------------------------

# Comma-separated Clerk user ids allowed to open /admin. If this is unset, /admin denies
# EVERYONE — including the founder — and the waitlist queue is unreachable even though the
# code is fine. This is the single most common reason admission appears broken.
MNEIA_SUPER_ADMIN_SUBJECTS=

# Resend credentials for the access email. If either is unset, approving a signup is
# REFUSED rather than approving someone we then cannot reach.
RESEND_API_KEY=
WAITLIST_FROM=

# ---------------------------------------------------------------------------
# Optional — sensible defaults, set them only to override
# ---------------------------------------------------------------------------

# Origin of the app itself, used to build device-flow verification URLs.
# Defaults to https://app.mneia.dev
# MNEIA_APP_ORIGIN=

# Origin of the marketing site, used for links inside the access email.
# MNEIA_SITE_ORIGIN=

# Absolute path for the §17 telemetry JSONL sink. Unset means telemetry is a no-op,
# which loses the arbitration dataset — the thing docs/BUSINESS.md calls the moat.
# MNEIA_TELEMETRY_PATH=

# Opt-out switch and remote sink for the §17 event spine.
# MNEIA_TELEMETRY=
# MNEIA_TELEMETRY_ENDPOINT=
# MNEIA_TELEMETRY_TOKEN=

# Which model extracts items from a trajectory. Defaults to gpt-5.6-luna, and the
# value is checked against an allowlist at startup rather than passed through, so a
# typo fails loudly instead of billing an unexpected model. MNE-180 exists to tune
# this against real sessions — the ledger in checkpoint_usage is what it reads.
# MNEIA_EXTRACTION_MODEL=

# The fallback, used only on 5xx, 429, or timeout from the primary. Defaults to
# claude-haiku-4-5. Deliberately a different vendor: an OpenAI outage would
# otherwise take checkpoint down entirely, and checkpoint is the one operation
# that cannot degrade. Note its 200K context is smaller than the primary's 1.05M.
# MNEIA_EXTRACTION_FALLBACK_MODEL=

# Which model computes embeddings. Defaults to text-embedding-3-small at 1536
# dimensions, ruled in MNE-176. Changing it does not re-embed what is already
# stored: context_item_embedding is keyed (item_id, model) precisely so a better
# model can be backfilled with both queryable at once.
# MNEIA_EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# Rate limits and abuse controls (MNE-173)
# ---------------------------------------------------------------------------
# Every one of these has a working default, so leaving them unset is safe. They exist
# so a limit can be raised for an account without a deploy. A non-positive or
# non-numeric value is rejected at startup rather than silently falling back.
#
# Hosted-only means we absorb every request, and checkpoint is the expensive call —
# it is the one that reaches a model. Reads are capped loosely, checkpoints tightly,
# and the workspace-daily ceiling is the backstop against a runaway CI loop.

# Requests per minute, per API token. Default 120.
# MNEIA_RATE_LIMIT_REQUESTS_PER_MINUTE=

# Checkpoints per hour, per API token. Default 60.
# MNEIA_RATE_LIMIT_CHECKPOINTS_PER_HOUR=

# Checkpoints per day, per workspace — keyed on the workspace, not the token, so
# issuing a fresh token does not reset it. Default 200.
#
# This was 500 while checkpointing was something a human triggered by hand. Auto
# triggering changes the exposure: at roughly $0.007 of inference per checkpoint,
# 500 a day is about $105 a month for a single free solo workspace, and §14 says
# the solo tier stays free. 200 is still far above any real usage pattern.
# MNEIA_RATE_LIMIT_CHECKPOINTS_PER_DAY=

# Largest accepted request body in bytes. An unbounded transcript is an unbounded
# prompt. Default 1048576 (1 MiB).
# MNEIA_MAX_REQUEST_BYTES=

# ---------------------------------------------------------------------------
# Must NOT be set in production
# ---------------------------------------------------------------------------

# Setting this to 1 disables the row-level-security guard on every connection, which
# makes every workspace-isolation policy inert (§11.3). /api/health reports
# rls=bypassed_by_escape_hatch when it is set, so the state is visible rather than silent.
# MNEIA_ALLOW_RLS_BYPASS=
