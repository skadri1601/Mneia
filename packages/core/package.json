{
  "name": "@mneia/core",
  "version": "0.11.0",
  "description": "Data model, checkpoint, rehydration, handoff, and telemetry for Mneia.",
  "keywords": [
    "mneia",
    "ai-agents",
    "context",
    "checkpoint",
    "handoff"
  ],
  "homepage": "https://mneia.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skadri1601/Mneia.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/skadri1601/Mneia/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "prepublishOnly": "node ../../scripts/sync-version.mjs --check"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "gpt-tokenizer": "^3.4.0"
  }
}
