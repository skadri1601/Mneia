{
  "name": "mneia-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "lint": "biome check .",
    "lint:ci": "biome lint --diagnostic-level=error .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:tests": "node scripts/check-test-integrity.mjs",
    "check:policy": "node scripts/check-git-policy.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:provision-app-role": "node scripts/db-provision-app-role.mjs",
    "bootstrap:local": "node scripts/bootstrap-local.mjs",
    "waitlist:notify": "node scripts/waitlist-notify.mjs",
    "db:snapshot": "node scripts/db-snapshot.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:dry": "changeset publish --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@clerk/shared",
      "@sentry/cli",
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
