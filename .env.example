# Copy to .env and fill in. .env is gitignored — never commit a real connection string.
#
# This file is the inventory of every variable this repo reads: names and purposes here,
# values never. For the variables the deployed app needs, see deploy/web.env.example.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Hosted Postgres (Neon). docs/STACK.md rules Neon as the engine; §11.1 rules it the only one.
# Used by `pnpm db:migrate`, `pnpm db:snapshot`, and the tests/integration/ suite,
# which skips itself when this is unset.
#
# Use the DIRECT connection string, not the -pooler one. The migration runner holds a
# session-level pg_advisory_lock across the whole run, and Neon's pooled endpoint is
# PgBouncer in transaction mode, where the server connection can change between statements.
#
# Direct   (use this):  postgresql://user:password@host.neon.tech/neondb?sslmode=require
# Pooled   (do not):    postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require&channel_binding=require

# Set to 1 for ONE privileged command — a migration against a role that legitimately
# bypasses RLS. Never set it for the application: it disables workspace isolation on
# every connection, and /api/health will report rls=bypassed_by_escape_hatch to say so.
# MNEIA_ALLOW_RLS_BYPASS=

# ---------------------------------------------------------------------------
# apps/site — advertising and analytics tags (MNE-222)
# ---------------------------------------------------------------------------
# All three are optional: leave any of them unset and that tag never loads, the consent
# banner never appears, and the site behaves exactly as it did before MNE-222 landed.
# These are NEXT_PUBLIC_ and are inlined into the client bundle at build time.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# CLI and MCP server — only needed to run them against a local API
# ---------------------------------------------------------------------------
# MNEIA_TOKEN=            # a device token; the CI path, equivalent to ~/.mneia/credentials
# MNEIA_API_URL=          # hosted API endpoint. Defaults to https://app.mneia.dev
# MNEIA_AUTH_URL=         # device-flow origin. Defaults to https://app.mneia.dev
# MNEIA_TELEMETRY=        # set to "off" to opt out of the §17 event spine

# ---------------------------------------------------------------------------
# Model providers — NOT SET YET, being provisioned (MNE-265)
# ---------------------------------------------------------------------------
# Leave the values empty here. This file is committed; real keys go in .env,
# which is gitignored, and in /etc/mneia/web.env on the droplet.
#
# Only three models are reachable, allowlisted in code, not read from these:
#   extraction primary   gpt-5.6-luna            (OPENAI_API_KEY)
#   extraction fallback  claude-haiku-4-5        (ANTHROPIC_API_KEY)
#   embeddings           text-embedding-3-small  (OPENAI_API_KEY)
#
# Without OPENAI_API_KEY, `mneia checkpoint` cannot propose and rehydrate ranks
# on recency alone — both degrade quietly rather than erroring, so check
# `curl -s https://app.mneia.dev/api/health` rather than assuming.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
